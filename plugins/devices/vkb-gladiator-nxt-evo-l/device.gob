# Gladiator NXT EVO "Space Combat Edition", left hand: SCG Premium grip (twist, dual action, rapid fire
# trigger, 3 four-way hats with push (the right hat is a mini stick; as a hat by default), a grey mini stick that works as a fourth hat, 4 buttons) on the GNX EVO base (X/Y, 3 buttons, encoder,
# throttle wheel, auto-centering 3-position switch), as listed by VKB's stores.
# The grip sends what VKBDevCfg sets up; inputs.gob is the factory profile, users teach their own.
id = "vkb-gladiator-nxt-evo-l"
name = "Gladiator NXT EVO (left)"
brand = "VKB"
credit = "Product images (c) VKB-Sim, used with permission"
version = "1"

[[match]]
vid = 0x231D
name = "Gladiator EVO L"

[[view]]
id = "main"
name = "Stick"
image = "views/main.png"

# Grip

[[control]]
id = "right_hat"
name = "Right hat (mini stick)"
kind = "hat"
parts = ["up", "right", "down", "left", "push"]
at = [408, 65]
side = "right"

[[control]]
id = "centre_hat"
name = "Centre hat"
kind = "hat"
parts = ["up", "right", "down", "left", "push"]
at = [365, 108]
side = "right"

[[control]]
id = "red_button"
name = "Red button"
kind = "button"
at = [410, 135]
side = "right"

[[control]]
id = "mini_stick"
name = "Mini stick"
kind = "hat"
parts = ["up", "right", "down", "left", "push"]
at = [358, 248]
side = "right"

[[control]]
id = "rapid_fire"
name = "Rapid fire trigger"
kind = "lever"
at = [480, 178]
side = "right"

[[control]]
id = "trigger"
name = "Trigger"
kind = "trigger"
at = [425, 200]
side = "right"

[[control]]
id = "pinky"
name = "Pinky button"
kind = "button"
at = [395, 330]
side = "right"

[[control]]
id = "left_hat"
name = "Left hat"
kind = "hat"
parts = ["up", "right", "down", "left", "push"]
at = [355, 52]
side = "left"

[[control]]
id = "stick"
name = "Stick axes"
kind = "stick"
parts = ["x", "y", "twist"]
at = [300, 450]
side = "left"

# Base

[[control]]
id = "f2"
name = "F2"
kind = "button"
at = [148, 522]
side = "left"
group = "Base buttons"

[[control]]
id = "f1"
name = "F1"
kind = "button"
at = [188, 538]
side = "left"
group = "Base buttons"

[[control]]
id = "f3"
name = "F3"
kind = "button"
at = [232, 560]
side = "left"
group = "Base buttons"

[[control]]
id = "en1"
name = "EN1 encoder"
kind = "encoder"
at = [192, 600]
side = "left"

[[control]]
id = "wheel"
name = "Centre wheel"
kind = "axis"
at = [148, 590]
side = "left"

[[control]]
id = "sw1"
name = "SW1 switch"
kind = "switch"
at = [100, 578]
side = "left"

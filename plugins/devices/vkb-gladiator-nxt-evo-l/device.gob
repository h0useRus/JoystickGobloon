# Gladiator NXT EVO "Space Combat Edition", left hand: SCG standard grip (twist, dual action
# trigger, 3 four-way hats with push, 4 buttons) on the GNX EVO base (X/Y, 3 buttons, encoder,
# throttle wheel, auto-centering 3-position switch), as listed by VKB's stores.
# The grip sends what VKBDevCfg sets up; inputs.gob is the factory profile, users teach their own.
id = "vkb-gladiator-nxt-evo-l"
name = "Gladiator NXT EVO (left)"
brand = "VKB"
credit = "Product images (c) VKB-Sim, used with permission"
version = "1"

[[match]]
vid = 0x231D
name = "Gladiator EVO L"

[[view]]
id = "main"
name = "Stick"
image = "views/main.png"

# Grip

[[control]]
id = "right_hat"
name = "Right hat"
kind = "hat"
parts = ["up", "right", "down", "left", "push"]
at = [411, 73]
side = "right"

[[control]]
id = "centre_hat"
name = "Centre hat"
kind = "hat"
parts = ["up", "right", "down", "left", "push"]
at = [367, 110]
side = "right"

[[control]]
id = "red_button"
name = "Red button"
kind = "button"
at = [411, 140]
side = "right"

[[control]]
id = "front_lever"
name = "Front lever"
kind = "lever"
at = [353, 256]
side = "right"

[[control]]
id = "trigger"
name = "Trigger"
kind = "trigger"
at = [436, 200]
side = "right"

[[control]]
id = "pinky"
name = "Pinky button"
kind = "button"
at = [392, 330]
side = "right"

[[control]]
id = "left_hat"
name = "Left hat"
kind = "hat"
parts = ["up", "right", "down", "left", "push"]
at = [355, 56]
side = "left"

[[control]]
id = "stick"
name = "Stick axes"
kind = "stick"
parts = ["x", "y", "twist"]
at = [303, 460]
side = "left"

# Base

[[control]]
id = "f2"
name = "F2"
kind = "button"
at = [220, 552]
side = "left"
group = "Base buttons"

[[control]]
id = "f1"
name = "F1"
kind = "button"
at = [183, 532]
side = "left"
group = "Base buttons"

[[control]]
id = "f3"
name = "F3"
kind = "button"
at = [147, 521]
side = "left"
group = "Base buttons"

[[control]]
id = "en1"
name = "EN1 encoder"
kind = "encoder"
at = [93, 603]
side = "left"

[[control]]
id = "wheel"
name = "Centre wheel"
kind = "axis"
at = [137, 610]
side = "left"

[[control]]
id = "sw1"
name = "SW1 switch"
kind = "switch"
at = [179, 630]
side = "left"

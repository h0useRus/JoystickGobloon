# Gladiator NXT EVO "Space Combat Edition", right hand on the Omni Throttle adapter: the stick works as a throttle: SCG Premium grip (twist, dual action, rapid fire
# trigger, 3 four-way hats with push (the left hat is a mini stick; as a hat by default), a grey mini stick that works as a fourth hat, 4 buttons) on the GNX EVO base (X/Y, 3 buttons, encoder,
# throttle wheel, auto-centering 3-position switch), as listed by VKB's stores.
# The grip sends what VKBDevCfg sets up; inputs.gob is the factory profile, users teach their own.
id = "vkb-gladiator-nxt-evo-ot-r"
name = "Gladiator NXT EVO Omni Throttle (right)"
brand = "VKB"
credit = "Product images (c) VKB-Sim, used with permission"
version = "1"

[[match]]
vid = 0x231D
name = "Gladiator EVO OT R"

[[view]]
id = "main"
name = "Throttle"
image = "views/main.png"

# Grip

[[control]]
id = "left_hat"
name = "Left hat (mini stick)"
kind = "hat"
parts = ["up", "right", "down", "left", "push"]
at = [155, 142]
side = "left"

[[control]]
id = "centre_hat"
name = "Centre hat"
kind = "hat"
parts = ["up", "right", "down", "left", "push"]
at = [205, 126]
side = "right"

[[control]]
id = "red_button"
name = "Red button"
kind = "button"
at = [195, 189]
side = "left"

[[control]]
id = "mini_stick"
name = "Mini stick"
kind = "hat"
parts = ["up", "right", "down", "left", "push"]
at = [300, 232]
side = "left"

[[control]]
id = "rapid_fire"
name = "Rapid fire trigger"
kind = "lever"
at = [212, 214]
side = "right"

[[control]]
id = "trigger"
name = "Trigger"
kind = "trigger"
at = [232, 211]
side = "left"

[[control]]
id = "pinky"
name = "Pinky button"
kind = "button"
at = [395, 262]
side = "right"

[[control]]
id = "right_hat"
name = "Right hat"
kind = "hat"
parts = ["up", "right", "down", "left", "push"]
at = [171, 55]
side = "right"

[[control]]
id = "stick"
name = "Throttle axes"
kind = "stick"
parts = ["x", "y", "twist"]
at = [326, 347]
side = "right"

# Base

[[control]]
id = "f2"
name = "F2"
kind = "button"
at = [413, 509]
side = "right"
group = "Base buttons"

[[control]]
id = "f1"
name = "F1"
kind = "button"
at = [451, 487]
side = "right"
group = "Base buttons"

[[control]]
id = "f3"
name = "F3"
kind = "button"
at = [487, 471]
side = "right"
group = "Base buttons"

[[control]]
id = "en1"
name = "EN1 encoder"
kind = "encoder"
at = [536, 534]
side = "right"

[[control]]
id = "wheel"
name = "Centre wheel"
kind = "axis"
at = [496, 555]
side = "right"

[[control]]
id = "sw1"
name = "SW1 switch"
kind = "switch"
at = [457, 569]
side = "right"

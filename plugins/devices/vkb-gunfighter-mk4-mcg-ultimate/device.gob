# Gunfighter Mk.IV "Modern Combat Edition" Ultimate: MCG Ultimate grip (right hand) on the Gunfighter Mk.IV base, as
# listed by VKB's stores and its forum: Master Mode and Gate Cont mini sticks (modular: either can be a 4-way hat
# with push instead), Manvr/PC, DC and Reset 4-way hats with push, a red and two grey buttons, a dual-stage trigger,
# a metal folding trigger and a brake lever axis; the base gives X/Y, the twist module (optional) a twist axis.
# The grip sends what VKBDevCfg sets up; inputs.gob is empty until a stick on the factory profile teaches it.
id = "vkb-gunfighter-mk4-mcg-ultimate"
name = "Gunfighter Mk.IV MCG Ultimate"
brand = "VKB"
credit = "Product images (c) VKB-Sim, used with permission"
version = "1"

[[match]]
vid = 0x231D
name = "Modern Combat Ultimate"

[[match]]
vid = 0x231D
name = "MCG Ultimate"

[[view]]
id = "main"
name = "Stick"
image = "views/main.png"

# Head

[[control]]
id = "red_button"
name = "Red button"
kind = "button"
at = [308, 52]
side = "left"

[[control]]
id = "master_mode"
name = "Master Mode mini stick"
kind = "hat"
parts = ["up", "right", "down", "left", "push"]
at = [340, 40]
side = "left"

[[control]]
id = "upper_grey"
name = "Upper grey button"
kind = "button"
at = [382, 30]
side = "right"

[[control]]
id = "lower_grey"
name = "Lower grey button"
kind = "button"
at = [378, 80]
side = "right"

[[control]]
id = "manvr_pc"
name = "Manvr/PC hat"
kind = "hat"
parts = ["up", "right", "down", "left", "push"]
at = [333, 105]
side = "left"

[[control]]
id = "gate_cont"
name = "Gate Cont mini stick"
kind = "stick"
parts = ["x", "y"]
at = [290, 112]
side = "left"

[[control]]
id = "dc_hat"
name = "DC hat"
kind = "hat"
parts = ["up", "right", "down", "left", "push"]
at = [478, 120]
side = "right"

# Grip

[[control]]
id = "reset_hat"
name = "Reset hat"
kind = "hat"
parts = ["up", "right", "down", "left", "push"]
at = [268, 203]
side = "left"

[[control]]
id = "trigger"
name = "Trigger"
kind = "trigger"
at = [387, 210]
side = "right"

[[control]]
id = "folding_trigger"
name = "Folding trigger"
kind = "button"
at = [430, 212]
side = "right"

[[control]]
id = "brake"
name = "Brake lever"
kind = "axis"
at = [420, 295]
side = "right"

# Base

[[control]]
id = "stick"
name = "Stick axes"
kind = "stick"
parts = ["x", "y", "twist"]
at = [340, 500]
side = "left"

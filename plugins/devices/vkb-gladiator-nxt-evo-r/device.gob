# Gladiator NXT EVO "Space Combat Edition", right hand: SCG standard grip (twist, dual action
# trigger, 3 four-way hats with push, 4 buttons) on the GNX EVO base (X/Y, 3 buttons, encoder,
# throttle wheel, auto-centering 3-position switch), as listed by VKB's stores.
# The grip sends what VKBDevCfg sets up; inputs.gob is the factory profile, users teach their own.
id = "vkb-gladiator-nxt-evo-r"
name = "Gladiator NXT EVO (right)"
brand = "VKB"
credit = "Product images (c) VKB-Sim, used with permission"
version = "1"

[[match]]
vid = 0x231D
name = "Gladiator EVO R"

[[view]]
id = "main"
name = "Stick"
image = "views/main.png"

# Grip

[[control]]
id = "left_hat"
name = "Left hat"
kind = "hat"
parts = ["up", "right", "down", "left", "push"]
at = [173, 75]
side = "left"

[[control]]
id = "centre_hat"
name = "Centre hat"
kind = "hat"
parts = ["up", "right", "down", "left", "push"]
at = [219, 110]
side = "left"

[[control]]
id = "red_button"
name = "Red button"
kind = "button"
at = [173, 140]
side = "left"

[[control]]
id = "front_lever"
name = "Front lever"
kind = "lever"
at = [228, 257]
side = "left"

[[control]]
id = "trigger"
name = "Trigger"
kind = "trigger"
at = [165, 200]
side = "left"

[[control]]
id = "pinky"
name = "Pinky button"
kind = "button"
at = [205, 350]
side = "left"

[[control]]
id = "right_hat"
name = "Right hat"
kind = "hat"
parts = ["up", "right", "down", "left", "push"]
at = [231, 54]
side = "right"

[[control]]
id = "stick"
name = "Stick axes"
kind = "stick"
parts = ["x", "y", "twist"]
at = [280, 447]
side = "right"

# Base

[[control]]
id = "f2"
name = "F2"
kind = "button"
at = [353, 547]
side = "right"
group = "Base buttons"

[[control]]
id = "f1"
name = "F1"
kind = "button"
at = [405, 527]
side = "right"
group = "Base buttons"

[[control]]
id = "f3"
name = "F3"
kind = "button"
at = [455, 511]
side = "right"
group = "Base buttons"

[[control]]
id = "en1"
name = "EN1 encoder"
kind = "encoder"
at = [500, 580]
side = "right"

[[control]]
id = "wheel"
name = "Centre wheel"
kind = "axis"
at = [457, 603]
side = "right"

[[control]]
id = "sw1"
name = "SW1 switch"
kind = "switch"
at = [408, 620]
side = "right"

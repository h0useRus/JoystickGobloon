# Gladiator NXT EVO "Space Combat Edition", right hand: SCG Premium grip (twist, dual action, rapid fire
# trigger, 3 four-way hats with push (the left hat is the analog mini stick: X/Y axes and a push), a grey mini stick that works as a fourth hat, 4 buttons) on the GNX EVO base (X/Y, 3 buttons, encoder,
# throttle wheel, auto-centering 3-position switch), as listed by VKB's stores.
# The grip sends what VKBDevCfg sets up; inputs.gob is the factory profile, users teach their own.
id = "vkb-gladiator-nxt-evo-r"
name = "Gladiator NXT EVO (right)"
brand = "VKB"
credit = "Product images (c) VKB-Sim, used with permission"
version = "1"

[[match]]
vid = 0x231D
name = "Gladiator EVO R"

[[view]]
id = "main"
name = "Stick"
image = "views/main.png"

# Grip

[[control]]
id = "left_hat"
name = "Left hat (mini stick)"
kind = "stick"
parts = ["x", "y", "push"]
at = [165, 65]
side = "left"

[[control]]
id = "centre_hat"
name = "Centre hat"
kind = "hat"
parts = ["up", "right", "down", "left", "push"]
at = [215, 105]
side = "left"

[[control]]
id = "red_button"
name = "Red button"
kind = "button"
at = [172, 138]
side = "left"

[[control]]
id = "mini_stick"
name = "Mini stick"
kind = "hat"
parts = ["up", "right", "down", "left", "push"]
at = [230, 252]
side = "left"

[[control]]
id = "rapid_fire"
name = "Rapid fire trigger"
kind = "lever"
at = [108, 178]
side = "left"

[[control]]
id = "trigger"
name = "Trigger"
kind = "trigger"
at = [160, 205]
side = "left"

[[control]]
id = "pinky"
name = "Pinky button"
kind = "button"
at = [210, 350]
side = "left"

[[control]]
id = "right_hat"
name = "Right hat"
kind = "hat"
parts = ["up", "right", "down", "left", "push"]
at = [230, 50]
side = "right"

[[control]]
id = "stick"
name = "Stick axes"
kind = "stick"
parts = ["x", "y", "twist"]
at = [268, 450]
side = "right"

# Base

[[control]]
id = "f2"
name = "F2"
kind = "button"
at = [380, 543]
side = "right"
group = "Base buttons"

[[control]]
id = "f1"
name = "F1"
kind = "button"
at = [418, 522]
side = "right"
group = "Base buttons"

[[control]]
id = "f3"
name = "F3"
kind = "button"
at = [457, 505]
side = "right"
group = "Base buttons"

[[control]]
id = "en1"
name = "EN1 encoder"
kind = "encoder"
at = [507, 575]
side = "right"

[[control]]
id = "wheel"
name = "Centre wheel"
kind = "axis"
at = [465, 590]
side = "right"

[[control]]
id = "sw1"
name = "SW1 switch"
kind = "switch"
at = [425, 615]
side = "right"

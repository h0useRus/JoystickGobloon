# Gladiator NXT EVO "Space Combat Edition", left hand on the Omni Throttle adapter: the stick works as a throttle: SCG Premium grip (twist, dual action, rapid fire
# trigger, 3 four-way hats with push (the right hat is the analog mini stick: X/Y axes and a push), a grey mini stick that works as a fourth hat, 4 buttons) on the GNX EVO base (X/Y, 3 buttons, encoder,
# throttle wheel, auto-centering 3-position switch), as listed by VKB's stores.
# The grip sends what VKBDevCfg sets up; inputs.gob is the factory profile, users teach their own.
id = "vkb-gladiator-nxt-evo-ot-l"
name = "Gladiator NXT EVO Omni Throttle (left)"
brand = "VKB"
credit = "Product images (c) VKB-Sim, used with permission"
version = "1"

[[match]]
vid = 0x231D
name = "Gladiator EVO OT L"

[[view]]
id = "main"
name = "Throttle"
image = "views/main.png"

# Grip

[[control]]
id = "right_hat"
name = "Right hat (mini stick)"
kind = "stick"
parts = ["x", "y", "push"]
at = [521, 139]
side = "right"

[[control]]
id = "centre_hat"
name = "Centre hat"
kind = "hat"
parts = ["up", "right", "down", "left", "push"]
at = [474, 121]
side = "left"

[[control]]
id = "red_button"
name = "Red button"
kind = "button"
at = [482, 184]
side = "right"

[[control]]
id = "mini_stick"
name = "Mini stick"
kind = "hat"
parts = ["up", "right", "down", "left", "push"]
at = [366, 224]
side = "right"

[[control]]
id = "rapid_fire"
name = "Rapid fire trigger"
kind = "lever"
at = [440, 204]
side = "left"

[[control]]
id = "trigger"
name = "Trigger"
kind = "trigger"
at = [421, 211]
side = "right"

[[control]]
id = "pinky"
name = "Pinky button"
kind = "button"
at = [265, 275]
side = "left"

[[control]]
id = "left_hat"
name = "Left hat"
kind = "hat"
parts = ["up", "right", "down", "left", "push"]
at = [508, 55]
side = "left"

[[control]]
id = "stick"
name = "Throttle axes"
kind = "stick"
parts = ["x", "y", "twist"]
at = [332, 342]
side = "left"

# Base

[[control]]
id = "f2"
name = "F2"
kind = "button"
at = [164, 455]
side = "left"
group = "Base buttons"

[[control]]
id = "f1"
name = "F1"
kind = "button"
at = [202, 471]
side = "left"
group = "Base buttons"

[[control]]
id = "f3"
name = "F3"
kind = "button"
at = [243, 492]
side = "left"
group = "Base buttons"

[[control]]
id = "en1"
name = "EN1 encoder"
kind = "encoder"
at = [194, 567]
side = "left"

[[control]]
id = "wheel"
name = "Centre wheel"
kind = "axis"
at = [150, 542]
side = "left"

[[control]]
id = "sw1"
name = "SW1 switch"
kind = "switch"
at = [114, 517]
side = "left"

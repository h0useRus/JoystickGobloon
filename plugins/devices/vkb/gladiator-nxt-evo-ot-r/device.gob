# Gladiator NXT EVO "Space Combat Edition", right hand on the Omni Throttle adapter: the stick works as a throttle: SCG Premium grip (twist, dual action, rapid fire
# trigger, 3 four-way hats with push (the left hat is a mini stick on a POV hat; its push only switches it between 8 and 4 ways), a grey mini stick that works as a fourth hat, 4 buttons) on the GNX EVO base (X/Y, 3 buttons, encoder,
# throttle wheel, auto-centering 3-position switch), as listed by VKB's stores.
# The grip sends what VKBDevCfg sets up; controls are placed with Map Gobloon.
id = "vkb-gladiator-nxt-evo-ot-r"
name = "Gladiator NXT EVO Omni Throttle (right)"
brand = "VKB"
credit = "Product images (c) VKB-Sim, used with permission"
version = "1"

[[match]]
vid = 0x231D
name = "Gladiator EVO OT R"

[[view]]
id = "main"
name = "Throttle"
image = "views/main.png"

[[control]]
id = "hat_1"
name = "Hat 1"
kind = "hat"
at = [153, 147]

[[control]]
id = "button_1"
name = "Button 1"
kind = "button"
at = [92, 216]

[[control]]
id = "button_2"
name = "Button 2"

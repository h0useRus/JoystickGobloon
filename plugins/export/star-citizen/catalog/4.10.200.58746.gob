category = "Camera - Advanced Camera Controls"
name = "Z Offset Positive"
default = ["kb1_pgup"]

[[action]]
id = "view_director_mode/view_move_target_Z_neg"
category = "Camera - Advanced Camera Controls"
name = "Z Offset Negative"
default = ["kb1_pgdn"]

[[action]]
id = "view_director_mode/view_fov_in"
category = "Camera - Advanced Camera Controls"
name = "Increase FoV"
default = ["kb1_np_add"]

[[action]]
id = "view_director_mode/view_fov_out"
category = "Camera - Advanced Camera Controls"
name = "Decrease FoV"
default = ["kb1_np_subtract"]

[[action]]
id = "view_director_mode/view_fstop_in"
category = "Camera - Advanced Camera Controls"
name = "Increase DoF"
default = ["kb1_home"]

[[action]]
id = "view_director_mode/view_fstop_out"
category = "Camera - Advanced Camera Controls"
name = "Decrease DoF"
default = ["kb1_end"]

[[action]]
id = "view_director_mode/view_restore_defaults"
category = "Camera - Advanced Camera Controls"
name = "Reset Current View"
default = ["kb1_np_multiply"]
